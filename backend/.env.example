PROJECT_NAME=GeoAid Core API
# true solo en desarrollo: registra los payloads y permite probar sin WHATSAPP_APP_SECRET
DEBUG=false

# Meta for Developers > tu app > WhatsApp > Configuración de la API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v21.0

# Lo inventas tú y escribes el mismo valor en Meta al registrar el webhook
WEBHOOK_VERIFY_TOKEN=

# Meta for Developers > tu app > Configuración de la app > Básica > Clave secreta de la app
WHATSAPP_APP_SECRET=

# Rutas relativas a la carpeta backend/
DATABASE_URL=sqlite:///./geoaid.db
MEDIA_DIR=./data/media

# Celulares del stand/equipo (57XXXXXXXXXX, separados por coma): pueden usar "reiniciar demo"
DEMO_PHONES=
# Sitios web que pueden leer /api/v1/reports/* desde el navegador
CORS_ORIGINS=https://geo-aid-coral.vercel.app,http://localhost:3000
